---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HelpPanel from '../components/HelpPanel.astro';
import CartDrawer from '../components/CartDrawer.astro';
import { withBase, stripBase } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  bodyClass?: string;
}
const {
  title,
  description = '農林水産大臣賞を四度受賞。埼玉県入間市の平塚園が、自園で育て丹精込めて造った狭山茶をお届けします。煎茶・ほうじ茶・贈り物用セットなど。',
  ogImage = '/images/photo/field-tokorozawa.jpg',
  bodyClass = '',
} = Astro.props;
const siteName = '狭山茶の平塚園';
const fullTitle = title ? `${title}｜${siteName}` : `${siteName}｜農林水産大臣賞 四度受賞の狭山茶`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// 確認用に公開するビルド（GitHub Pages）では、検索エンジンに載せず、確認用サイトである旨を表示する
const preview = import.meta.env.PUBLIC_PREVIEW === 'true';
---
<!doctype html>
<html lang="ja" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {preview && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content={stripBase(Astro.url.pathname) === '/' ? 'website' : 'article'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(withBase(ogImage), Astro.site)} />
    <meta property="og:site_name" content={siteName} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Barlow:wght@500;600&family=Noto+Sans+JP:wght@400;500;700;900&family=Noto+Serif+JP:wght@500;700&display=swap"
    />
  </head>
  <body class={bodyClass} id="top">
    <a class="skip" href="#main">本文へスキップ</a>
    {preview && (
      <p class="preview-bar" role="note">
        このサイトは平塚園ホームページのリニューアル確認用です。商品のご購入・お問い合わせの送信はできません。
        <a href="https://www.hiratsukaen.co.jp/">現在の公式サイトはこちら</a>
      </p>
    )}
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <HelpPanel />
    <CartDrawer />
    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
