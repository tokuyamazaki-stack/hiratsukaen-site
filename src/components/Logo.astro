---
/**
 * 仮ロゴ（屋号「貞」マーク＋平塚園）。正式なロゴデータを受領したら差し替えてください。
 */
interface Props {
  variant?: 'default' | 'white';
  class?: string;
}
const { variant = 'default', class: className = '' } = Astro.props;
---
<span class={`logo logo--${variant} ${className}`}>
  <svg class="logo__mark" viewBox="0 0 48 48" aria-hidden="true">
    <circle cx="24" cy="24" r="21.5" fill="none" stroke="currentColor" stroke-width="3" />
    <text x="24" y="32.5" text-anchor="middle" font-size="24" font-weight="700" fill="currentColor" font-family="'Noto Serif JP', serif">貞</text>
  </svg>
  <span class="logo__text">
    <span class="logo__sub">狭山茶</span>
    <span class="logo__name">平塚園</span>
  </span>
</span>
